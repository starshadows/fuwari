{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fuwari",
	"compatibility_date": "2026-05-19",
	"compatibility_flags": [],
	"main": "src/worker/index.ts",
	"keep_vars": true,
	"routes": [
		{
			"pattern": "api.starshadow.cc/*",
			"zone_name": "starshadow.cc"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET"
		}
	]
}
