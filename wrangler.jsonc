{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fuwari",
	"compatibility_date": "2026-05-19",
	"compatibility_flags": [],
	"main": "src/worker/index.ts",
	"keep_vars": true,
	"d1_databases": [
		{
			"binding": "DB"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET"
		}
	]
}
