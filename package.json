{
	"name": "fuwari",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"check": "astro check",
		"sync-posts": "node scripts/sync-posts.mjs",
		"migrate-posts": "node scripts/migrate-posts-to-r2.mjs",
		"build": "node scripts/sync-posts.mjs && astro build && pagefind --site dist",
		"preview": "astro preview",
		"worker:dev": "wrangler dev --port 8787",
		"worker:deploy": "pnpm build && wrangler deploy",
		"d1:migrate:local": "wrangler d1 migrations apply fuwari-data --local",
		"d1:migrate:remote": "wrangler d1 migrations apply fuwari-data --remote",
		"astro": "astro",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"new-post": "node scripts/new-post.js",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format:check": "biome format ."
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/svelte": "^8.1.2",
		"@expressive-code/core": "^0.42.0",
		"@expressive-code/plugin-collapsible-sections": "^0.42.0",
		"@expressive-code/plugin-line-numbers": "^0.42.0",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/roboto": "^5.2.10",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/fa6-regular": "^1.2.4",
		"@iconify-json/fa6-solid": "^1.2.4",
		"@iconify-json/material-symbols": "^1.2.75",
		"@iconify/svelte": "^5.2.1",
		"@swup/astro": "^1.8.0",
		"@tailwindcss/typography": "^0.5.19",
		"altcha": "3.0.10",
		"astro": "^6.4.2",
		"astro-expressive-code": "^0.42.0",
		"astro-icon": "^1.1.5",
		"fflate": "^0.8.3",
		"hastscript": "^9.0.1",
		"katex": "^0.17.0",
		"markdown-it": "^14.2.0",
		"mdast-util-to-string": "^4.0.0",
		"overlayscrollbars": "^2.16.0",
		"pagefind": "^1.5.2",
		"photoswipe": "^5.4.4",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-components": "^0.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-slug": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-directive-rehype": "^1.0.0",
		"remark-github-admonitions-to-directives": "^2.1.0",
		"remark-math": "^6.0.0",
		"remark-sectionize": "^2.1.0",
		"sanitize-html": "^2.17.4",
		"sharp": "^0.34.5",
		"stylus": "^0.64.0",
		"svelte": "^5.55.10",
		"tailwindcss": "^3.4.19",
		"twikoo": "1.7.11",
		"typescript": "^6.0.3",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "^1.10.9",
		"@biomejs/biome": "2.4.16",
		"@cloudflare/workers-types": "^4.20260529.1",
		"@rollup/plugin-yaml": "^4.1.2",
		"@types/hast": "^3.0.4",
		"@types/markdown-it": "^14.1.2",
		"@types/mdast": "^4.0.4",
		"@types/sanitize-html": "^2.16.1",
		"miniflare": "^4.20260526.0",
		"postcss-import": "^16.1.1",
		"postcss-nesting": "^13.0.2",
		"vitest": "^4.1.7",
		"wrangler": "^4.95.0"
	},
	"pnpm": {
		"overrides": {
			"@iconify/tools": "^4.2.0",
			"devalue": "^5.6.4",
			"fast-xml-parser": "^5.5.7",
			"form-data": "^4.0.4",
			"glob": "^10.5.0",
			"@babel/plugin-transform-modules-systemjs": "^7.29.7",
			"ajv": "^8.18.0",
			"brace-expansion@<1.1.13": "1.1.13",
			"brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
			"fast-uri": "^3.1.2",
			"immutable": "^5.1.5",
			"lodash": "^4.18.1",
			"minimatch@<3.1.4": "3.1.4",
			"minimatch@>=5.0.0 <5.1.8": "5.1.8",
			"minimatch@>=9.0.0 <9.0.7": "9.0.7",
			"picomatch@<2.3.2": "2.3.2",
			"picomatch@>=4.0.0 <4.0.4": "4.0.4",
			"postcss": "^8.5.15",
			"rollup@<2.80.0": "2.80.0",
			"rollup@>=4.0.0 <4.59.0": "^4.60.4",
			"serialize-javascript": "^7.0.3",
			"svgo@>=2.1.0 <2.8.1": "2.8.1",
			"svgo@>=3.0.0 <3.3.3": "3.3.3",
			"vite": "^7.3.2",
			"yaml@>=1.0.0 <1.10.3": "1.10.3",
			"yaml@>=2.0.0 <2.8.3": "2.8.3"
		}
	},
	"packageManager": "pnpm@9.14.4"
}
