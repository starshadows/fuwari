{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm build",
	"framework": "astro",
	"installCommand": "pnpm install --frozen-lockfile",
	"outputDirectory": "dist",
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "/api/proxy?path=:path*"
		},
		{
			"source": "/friends/admin",
			"destination": "/api/friends-admin"
		},
		{
			"source": "/friends/admin/",
			"destination": "/api/friends-admin"
		},
		{
			"source": "/friends/admin/index.html",
			"destination": "/api/friends-admin"
		},
		{
			"source": "/worker-admin-shell/:path*",
			"destination": "/api/admin-shell?path=:path*"
		},
		{
			"source": "/media/:path*",
			"destination": "/api/media-proxy?path=:path*"
		}
	]
}
