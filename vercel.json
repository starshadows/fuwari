{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm build",
	"framework": "astro",
	"installCommand": "pnpm install --frozen-lockfile",
	"outputDirectory": "dist",
	"redirects": [
		{
			"source": "/friends/admin",
			"destination": "https://api.starshadow.cc/friends/admin/",
			"permanent": false
		},
		{
			"source": "/friends/admin/:path*",
			"destination": "https://api.starshadow.cc/friends/admin/:path*",
			"permanent": false
		},
		{
			"source": "/worker-admin/:path*",
			"destination": "/",
			"permanent": false
		}
	],
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://api.starshadow.cc/api/:path*"
		},
		{
			"source": "/media/:path*",
			"destination": "https://api.starshadow.cc/media/:path*"
		}
	]
}
