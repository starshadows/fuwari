---
const adminUrl = "https://api.starshadow.cc/friends/admin/";
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="robots" content="noindex,nofollow" />
		<meta http-equiv="refresh" content={`0; url=${adminUrl}`} />
		<link rel="canonical" href={adminUrl} />
		<title>跳转到管理后台</title>
	</head>
	<body>
		<p>
			管理后台已迁移到 Cloudflare Worker。<a href={adminUrl}>继续访问</a>
		</p>
	</body>
</html>
