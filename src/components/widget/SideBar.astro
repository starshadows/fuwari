---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";
import Categories from "./Categories.astro";
import MusicPlayer from "./MusicPlayer.svelte";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";
import TOC from "./TOC.astro";
import VisitorStats from "./VisitorStats.svelte";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const headings = Astro.props.headings ?? [];
const showToc =
	siteConfig.toc.enable &&
	Astro.url.pathname.startsWith(url("/posts/")) &&
	headings.length > 0;
const useContainedSidebarScroll = showToc;
const tocEnabled = siteConfig.toc.enable;
const postPathPrefix = url("/posts/");
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div
        id="sidebar-sticky"
        data-contained-scroll={useContainedSidebarScroll ? "true" : "false"}
        class:list={[
            "flex flex-col w-full gap-4",
            {"sticky top-4 sidebar-contained-scroll": useContainedSidebarScroll},
        ]}
    >
        <Profile></Profile>
        <MusicPlayer client:idle />
        <VisitorStats client:load />
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
        <div id="toc-sidebar-widget" class:list={["min-h-0", {"hidden": !showToc}]}>
            <WidgetLayout name="目录" id="article-toc" class="!shrink min-h-0">
                <div id="toc-sidebar-scroll" data-toc-scroll class="overflow-y-auto overflow-x-hidden hide-scrollbar">
                    <div id="toc" class="relative w-full transition-swup-fade">
                        {tocEnabled && <TOC headings={headings}></TOC>}
                    </div>
                </div>
            </WidgetLayout>
        </div>
    </div>
</div>

<style>
    #sidebar {
        min-height: 0;
        transition: opacity 80ms ease;
        overflow-anchor: none;
    }

    #sidebar.sidebar-navigation-lock {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none;
    }

    #sidebar-sticky {
        padding-bottom: 1rem;
        overflow-anchor: none;
    }

    #sidebar-sticky.sidebar-contained-scroll {
        max-height: calc(100dvh - 1rem);
        overflow-y: auto;
        overflow-x: hidden;
        overscroll-behavior: contain;
        overscroll-behavior-y: contain;
        scrollbar-width: none;
    }

    #sidebar-sticky.sidebar-contained-scroll::-webkit-scrollbar {
        display: none;
    }

    #toc-sidebar-scroll {
        max-height: min(28rem, calc(100dvh - 24rem));
        min-height: 10rem;
        overscroll-behavior: contain;
        overscroll-behavior-y: contain;
    }

    @media (max-width: 1023px) {
        #sidebar-sticky.sidebar-contained-scroll {
            max-height: none;
            overflow: visible;
        }

        #toc-sidebar-scroll {
            max-height: none;
        }
    }
</style>

<style is:global>
    #sidebar-sticky > *,
    #sidebar-sticky > astro-island > * {
        flex-shrink: 0;
    }

    #sidebar-sticky > astro-island {
        display: block;
        width: 100%;
    }
</style>

<script is:inline define:vars={{ tocEnabled, postPathPrefix }}>
function clearSidebarTocSchedule() {
    if (!window.__fuwariSidebarTocState) return;
    if (window.__fuwariSidebarTocState.frame) {
        cancelAnimationFrame(window.__fuwariSidebarTocState.frame);
        window.__fuwariSidebarTocState.frame = 0;
    }
    for (const timer of window.__fuwariSidebarTocState.timers ?? []) {
        window.clearTimeout(timer);
    }
    window.__fuwariSidebarTocState.timers = [];
}

function syncSidebarTocEntries() {
    const toc = document.getElementById("toc");
    if (!toc) return;

    if (!tocEnabled || !window.location.pathname.startsWith(postPathPrefix)) {
        toc.replaceChildren();
        return;
    }

    const postContainer = document.getElementById("post-container");
    if (!postContainer) return;

    const headings = Array.from(
        postContainer.querySelectorAll("h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]"),
    ).filter((heading) => heading.textContent?.trim());

    if (headings.length === 0) return;

    const nextHrefs = headings.map((heading) => `#${heading.id}`);
    const currentHrefs = Array.from(toc.querySelectorAll("a[href^='#']")).map((link) =>
        link.getAttribute("href"),
    );

    if (
        currentHrefs.length === nextHrefs.length &&
        currentHrefs.every((href, index) => href === nextHrefs[index])
    ) {
        return;
    }

    const fragment = document.createDocumentFragment();
    for (const heading of headings) {
        const link = document.createElement("a");
        const level = Number(heading.tagName.slice(1));
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent.trim();
        link.className = "block w-full truncate text-sm transition hover:text-[var(--primary)]";
        link.style.paddingLeft = `${Math.max(0, level - 2) * 0.75}rem`;
        fragment.append(link);
    }
    toc.replaceChildren(fragment);
}

function toggleSidebarToc() {
    const widget = document.getElementById("toc-sidebar-widget");
    const toc = document.getElementById("toc");
    if (!widget || !toc) return;

    syncSidebarTocEntries();
    const hasEntries = tocEnabled && !!toc.querySelector("a[href^='#']");
    widget.classList.toggle("hidden", !hasEntries);
}

function scheduleSidebarTocToggle() {
    clearSidebarTocSchedule();
    sidebarTocState.frame = requestAnimationFrame(() => {
        sidebarTocState.frame = 0;
        toggleSidebarToc();
    });
    sidebarTocState.timers = [];
}

const sidebarTocState = window.__fuwariSidebarTocState ??= {
    swupBound: false,
    frame: 0,
    timers: [],
};

if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scheduleSidebarTocToggle, { once: true });
} else {
    scheduleSidebarTocToggle();
}

const setupSidebarTocSwup = () => {
    if (sidebarTocState.swupBound) return;
    sidebarTocState.swupBound = true;

    window.swup?.hooks?.on("page:view", scheduleSidebarTocToggle);
    window.swup?.hooks?.on("content:replace", scheduleSidebarTocToggle);
};

if (window.swup?.hooks) {
    setupSidebarTocSwup();
} else {
    document.addEventListener("swup:enable", setupSidebarTocSwup, { once: true });
}

function normalizeWheelDeltaY(event, scroller) {
    if (event.deltaMode === 1) return event.deltaY * 32;
    if (event.deltaMode === 2) return event.deltaY * scroller.clientHeight;
    return event.deltaY;
}

function setupSidebarScrollIsolation() {
    window.__fuwariSidebarScrollCleanup?.();

    const sidebar = document.getElementById("sidebar-sticky");
    const tocScroller = document.getElementById("toc-sidebar-scroll");
    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    const cleanup = [];

    if (!sidebar) return;
    if (sidebar.dataset.containedScroll !== "true") return;

    const scrollWithWheel = (event, scroller) => {
        if (!desktopQuery.matches || Math.abs(event.deltaY) < 0.5) return;

        event.preventDefault();
        event.stopPropagation();
        scroller.scrollTop += normalizeWheelDeltaY(event, scroller);
    };

    const bindWheel = (scroller, skipSelector) => {
        const onWheel = (event) => {
            if (skipSelector && event.target?.closest?.(skipSelector)) return;
            scrollWithWheel(event, scroller);
        };

        scroller.addEventListener("wheel", onWheel, { passive: false });
        cleanup.push(() => scroller.removeEventListener("wheel", onWheel));
    };

    const bindTouch = (scroller, skipSelector) => {
        let lastY = 0;

        const onTouchStart = (event) => {
            if (!desktopQuery.matches || event.touches.length !== 1) return;
            if (skipSelector && event.target?.closest?.(skipSelector)) return;
            lastY = event.touches[0].clientY;
        };

        const onTouchMove = (event) => {
            if (!desktopQuery.matches || event.touches.length !== 1) return;
            if (skipSelector && event.target?.closest?.(skipSelector)) return;

            const nextY = event.touches[0].clientY;
            const deltaY = lastY - nextY;
            lastY = nextY;

            if (Math.abs(deltaY) < 0.5) return;
            event.preventDefault();
            event.stopPropagation();
            scroller.scrollTop += deltaY;
        };

        scroller.addEventListener("touchstart", onTouchStart, { passive: true });
        scroller.addEventListener("touchmove", onTouchMove, { passive: false });
        cleanup.push(() => {
            scroller.removeEventListener("touchstart", onTouchStart);
            scroller.removeEventListener("touchmove", onTouchMove);
        });
    };

    const nestedScrollSelector = "#toc-sidebar-scroll, [data-music-playlist-scroll]";
    bindWheel(sidebar, nestedScrollSelector);
    bindTouch(sidebar, nestedScrollSelector);

    if (tocScroller) {
        bindWheel(tocScroller);
        bindTouch(tocScroller);
    }

    window.__fuwariSidebarScrollCleanup = () => {
        for (const cleanupItem of cleanup) cleanupItem();
        delete window.__fuwariSidebarScrollCleanup;
    };
}

function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
}

const sidebarScrollState = window.__fuwariSidebarScrollState ??= {
    timers: [],
    revealTimer: 0,
    swupBound: false,
    navigating: false,
    lastScrollIntentAt: 0,
    lastWindowScrollY: window.scrollY,
};

function clearSidebarScrollSyncTimers() {
    for (const timer of sidebarScrollState.timers) window.clearTimeout(timer);
    sidebarScrollState.timers = [];
}

function hideSidebarDuringNavigation() {
    if (sidebarScrollState.revealTimer) {
        window.clearTimeout(sidebarScrollState.revealTimer);
        sidebarScrollState.revealTimer = 0;
    }

    const sidebar = document.getElementById("sidebar");
    if (!sidebar) return;

    sidebar.classList.add("sidebar-navigation-lock");
    sidebar.style.setProperty("opacity", "0", "important");
    sidebar.style.setProperty("visibility", "hidden", "important");
    sidebar.style.pointerEvents = "none";
}

function revealSidebarAfterNavigation(delay = 48) {
    if (sidebarScrollState.revealTimer) {
        window.clearTimeout(sidebarScrollState.revealTimer);
    }

    sidebarScrollState.revealTimer = window.setTimeout(() => {
        const sidebar = document.getElementById("sidebar");
        if (sidebar) {
            sidebar.classList.remove("sidebar-navigation-lock");
            sidebar.style.removeProperty("opacity");
            sidebar.style.removeProperty("visibility");
            sidebar.style.pointerEvents = "";
        }
        sidebarScrollState.revealTimer = 0;
    }, delay);
}

function teardownSidebarScrollSync() {
    clearSidebarScrollSyncTimers();
    window.__fuwariSidebarScrollSyncCleanup?.();
}

function setupSidebarScrollSync() {
    window.__fuwariSidebarScrollSyncCleanup?.();

    const sidebar = document.getElementById("sidebar-sticky");
    const tocWidget = document.getElementById("toc-sidebar-widget");
    const postContainer = document.getElementById("post-container");
    const desktopQuery = window.matchMedia("(min-width: 1024px)");

    if (!sidebar || !tocWidget || !postContainer) return;

    let animationFrame = 0;
    sidebarScrollState.lastWindowScrollY = window.scrollY;

    const syncSidebarToArticle = () => {
        animationFrame = 0;
        const currentScrollY = window.scrollY;
        const previousScrollY = sidebarScrollState.lastWindowScrollY;
        const isScrollingUp = currentScrollY < previousScrollY - 1;

        sidebarScrollState.lastWindowScrollY = currentScrollY;

        if (!desktopQuery.matches || tocWidget.classList.contains("hidden")) return;
        if (sidebarScrollState.navigating) return;

        const postTop = postContainer.getBoundingClientRect().top + currentScrollY;
        const syncStart = Math.max(0, postTop - 180);
        if (currentScrollY <= syncStart + 2) {
            sidebar.scrollTop = 0;
            return;
        }

        if (!isScrollingUp && Date.now() - sidebarScrollState.lastScrollIntentAt > 1200) return;

        const syncEnd = syncStart + Math.min(760, Math.max(360, postContainer.offsetHeight * 0.16));
        const progress = clamp((currentScrollY - syncStart) / (syncEnd - syncStart), 0, 1);
        const tocTarget = clamp(
            tocWidget.offsetTop - 16,
            0,
            Math.max(0, sidebar.scrollHeight - sidebar.clientHeight),
        );

        sidebar.scrollTop = Math.round(tocTarget * progress);
    };

    const scheduleSync = () => {
        if (animationFrame) return;
        animationFrame = requestAnimationFrame(syncSidebarToArticle);
    };

    const markScrollIntent = (event) => {
        if (event.target?.closest?.("#sidebar-sticky")) return;
        sidebarScrollState.lastScrollIntentAt = Date.now();
    };

    const markKeyboardScrollIntent = (event) => {
        if (
            ![
                "ArrowDown",
                "ArrowUp",
                "End",
                "Home",
                "PageDown",
                "PageUp",
                " ",
            ].includes(event.key)
        ) return;
        markScrollIntent(event);
    };

    window.addEventListener("wheel", markScrollIntent, { passive: true });
    window.addEventListener("touchstart", markScrollIntent, { passive: true });
    window.addEventListener("keydown", markKeyboardScrollIntent);
    window.addEventListener("scroll", scheduleSync, { passive: true });
    window.addEventListener("resize", scheduleSync);
    window.addEventListener("load", scheduleSync);

    window.__fuwariSidebarScrollSyncCleanup = () => {
        if (animationFrame) cancelAnimationFrame(animationFrame);
        window.removeEventListener("wheel", markScrollIntent);
        window.removeEventListener("touchstart", markScrollIntent);
        window.removeEventListener("keydown", markKeyboardScrollIntent);
        window.removeEventListener("scroll", scheduleSync);
        window.removeEventListener("resize", scheduleSync);
        window.removeEventListener("load", scheduleSync);
        delete window.__fuwariSidebarScrollSyncCleanup;
    };
}

function setupSidebarScrollSyncAfterNavigation() {
    teardownSidebarScrollSync();
    sidebarScrollState.lastScrollIntentAt = 0;
    sidebarScrollState.lastWindowScrollY = window.scrollY;
    sidebarScrollState.navigating = false;
    sidebarScrollState.timers = [];
    setupSidebarScrollSync();
    revealSidebarAfterNavigation();
}

const sidebarScrollIsolationState = window.__fuwariSidebarScrollIsolationState ??= {
    swupBound: false,
};

const setupSidebarScrollIsolationSwup = () => {
    if (sidebarScrollIsolationState.swupBound) return;
    sidebarScrollIsolationState.swupBound = true;

    window.swup?.hooks?.on("content:replace", setupSidebarScrollIsolation);
};

const setupInitialSidebarScrollSync = () => {
    sidebarScrollState.navigating = false;
    window.requestAnimationFrame(setupSidebarScrollSync);
};

setupSidebarScrollIsolation();
if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupInitialSidebarScrollSync, { once: true });
} else {
    setupInitialSidebarScrollSync();
}

if (window.swup?.hooks) {
    setupSidebarScrollIsolationSwup();
} else {
    document.addEventListener("swup:enable", setupSidebarScrollIsolationSwup, { once: true });
}

const setupSidebarScrollSyncSwup = () => {
    if (sidebarScrollState.swupBound) return;
    sidebarScrollState.swupBound = true;

    window.swup?.hooks?.on("visit:start", () => {
        sidebarScrollState.navigating = true;
        sidebarScrollState.lastScrollIntentAt = 0;
        sidebarScrollState.lastWindowScrollY = window.scrollY;
        hideSidebarDuringNavigation();
        teardownSidebarScrollSync();
    });
    window.swup?.hooks?.on("content:replace", () => {
        sidebarScrollState.navigating = true;
        sidebarScrollState.lastScrollIntentAt = 0;
        sidebarScrollState.lastWindowScrollY = window.scrollY;
        hideSidebarDuringNavigation();
        teardownSidebarScrollSync();
    });
    window.swup?.hooks?.on("page:view", setupSidebarScrollSyncAfterNavigation);
};

if (window.swup?.hooks) {
    setupSidebarScrollSyncSwup();
} else {
    document.addEventListener("swup:enable", setupSidebarScrollSyncSwup, { once: true });
}
</script>
