---
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";
import Categories from "./Categories.astro";
import MusicPlayer from "./MusicPlayer.svelte";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";
import VisitorStats from "./VisitorStats.svelte";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
const headings = Astro.props.headings ?? [];
const showToc =
	siteConfig.toc.enable &&
	Astro.url.pathname.startsWith(url("/posts/")) &&
	headings.length > 0;
const useContainedSidebarScroll = showToc;
const tocEnabled = siteConfig.toc.enable;
const postPathPrefix = url("/posts/");
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div
        id="sidebar-sticky"
        data-contained-scroll={useContainedSidebarScroll ? "true" : "false"}
        class:list={[
            "flex flex-col w-full gap-4",
            {"sticky top-4 sidebar-contained-scroll": useContainedSidebarScroll},
        ]}
    >
        <Profile></Profile>
        <MusicPlayer client:idle />
        <VisitorStats client:load />
        <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
        <div id="toc-sidebar-widget" class:list={["min-h-0", {"hidden": !showToc}]}>
            <WidgetLayout name="目录" id="article-toc" class="!shrink min-h-0">
                <div id="toc-sidebar-scroll" data-toc-scroll class="overflow-y-auto overflow-x-hidden hide-scrollbar">
                    <div id="toc" class="relative w-full transition-swup-fade"></div>
                </div>
            </WidgetLayout>
        </div>
    </div>
</div>

<style>
    #sidebar {
        min-height: 0;
        transition: opacity 80ms ease;
        overflow-anchor: none;
    }

    #sidebar.sidebar-navigation-lock {
        opacity: 0 !important;
        visibility: hidden !important;
        pointer-events: none;
    }

    #sidebar-sticky {
        padding-bottom: 1rem;
        overflow-anchor: none;
    }

    #sidebar-sticky.sidebar-contained-scroll {
        max-height: calc(100dvh - 1rem);
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: none;
    }

    #sidebar-sticky.sidebar-contained-scroll::-webkit-scrollbar {
        display: none;
    }

    #toc-sidebar-scroll {
        max-height: min(28rem, calc(100dvh - 24rem));
        min-height: 10rem;
    }

    @media (max-width: 1023px) {
        #sidebar-sticky.sidebar-contained-scroll {
            max-height: none;
            overflow: visible;
        }

        #toc-sidebar-scroll {
            max-height: none;
        }
    }
</style>

<style is:global>
    #sidebar-sticky > *,
    #sidebar-sticky > astro-island > * {
        flex-shrink: 0;
    }

    #sidebar-sticky > astro-island {
        display: block;
        width: 100%;
    }
</style>

<script is:inline define:vars={{ tocEnabled, postPathPrefix }}>
const sidebarController = window.__fuwariSidebarController ??= {
    cleanupScroll: undefined,
    cleanupSync: undefined,
    refreshFrame: 0,
    refreshTimers: [],
    revealTimer: 0,
    swupBound: false,
};

function cleanupSidebarScroll() {
    sidebarController.cleanupScroll?.();
    sidebarController.cleanupScroll = undefined;
}

function cleanupSidebarSync() {
    sidebarController.cleanupSync?.();
    sidebarController.cleanupSync = undefined;
}

function clearSidebarRefreshSchedule() {
    if (sidebarController.refreshFrame) {
        cancelAnimationFrame(sidebarController.refreshFrame);
        sidebarController.refreshFrame = 0;
    }

    for (const timer of sidebarController.refreshTimers) {
        window.clearTimeout(timer);
    }
    sidebarController.refreshTimers = [];
}

function getSidebarElements() {
    return {
        sidebarRoot: document.getElementById("sidebar"),
        sidebar: document.getElementById("sidebar-sticky"),
        toc: document.getElementById("toc"),
        tocScroller: document.getElementById("toc-sidebar-scroll"),
        tocWidget: document.getElementById("toc-sidebar-widget"),
    };
}

function isArticlePath() {
    return tocEnabled && window.location.pathname.startsWith(postPathPrefix);
}

function getPageScrollY() {
    return window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
}

function getElementPageTop(element) {
    return element.getBoundingClientRect().top + getPageScrollY();
}

function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
}

function normalizeWheelDeltaY(event, scroller) {
    if (event.deltaMode === 1) return event.deltaY * 32;
    if (event.deltaMode === 2) return event.deltaY * scroller.clientHeight;
    return event.deltaY;
}

function removeTailingHash(text) {
    const trimmed = text.trim();
    return trimmed.endsWith("#") ? trimmed.slice(0, -1) : trimmed;
}

function collectArticleHeadings() {
    if (!isArticlePath()) return [];

    const postContainer = document.getElementById("post-container");
    if (!postContainer) return [];

    return Array.from(
        postContainer.querySelectorAll("h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]"),
    ).filter((heading) => heading.textContent?.trim());
}

function buildSidebarToc(toc, headings) {
    if (!toc) return false;

    if (headings.length === 0) {
        toc.replaceChildren();
        toc.dataset.sidebarToc = "";
        return false;
    }

    const nextHrefs = headings.map((heading) => `#${heading.id}`);
    const currentHrefs = Array.from(toc.querySelectorAll("a[href^='#']")).map((link) =>
        link.getAttribute("href"),
    );

    if (
        toc.dataset.sidebarToc === "generated" &&
        currentHrefs.length === nextHrefs.length &&
        currentHrefs.every((href, index) => href === nextHrefs[index])
    ) {
        return true;
    }

    const fragment = document.createDocumentFragment();
    const minDepth = Math.min(...headings.map((heading) => Number(heading.tagName.slice(1))));

    for (const heading of headings) {
        const link = document.createElement("a");
        const level = Number(heading.tagName.slice(1));
        link.href = `#${heading.id}`;
        link.textContent = removeTailingHash(heading.textContent ?? "");
        link.className = [
            "block",
            "w-full",
            "truncate",
            "rounded-xl",
            "px-2",
            "py-2",
            "text-sm",
            "transition",
            "hover:bg-[var(--toc-btn-hover)]",
            "hover:text-[var(--primary)]",
        ].join(" ");
        link.style.paddingLeft = `${0.5 + Math.max(0, level - minDepth) * 0.75}rem`;
        fragment.append(link);
    }

    toc.replaceChildren(fragment);
    toc.dataset.sidebarToc = "generated";
    return true;
}

function setSidebarReadingMode(enabled) {
    const { sidebar, tocWidget } = getSidebarElements();
    if (!sidebar) return;

    sidebar.dataset.containedScroll = enabled ? "true" : "false";
    sidebar.classList.toggle("sticky", enabled);
    sidebar.classList.toggle("top-4", enabled);
    sidebar.classList.toggle("sidebar-contained-scroll", enabled);
    tocWidget?.classList.toggle("hidden", !enabled);

    if (!enabled) {
        sidebar.scrollTop = 0;
        const tocScroller = document.getElementById("toc-sidebar-scroll");
        if (tocScroller) tocScroller.scrollTop = 0;
    }
}

function resetSidebarScrollPosition() {
    const { sidebar, tocScroller } = getSidebarElements();
    if (sidebar) sidebar.scrollTop = 0;
    if (tocScroller) tocScroller.scrollTop = 0;
}

function scrollElementBy(scroller, delta) {
    const maxScroll = Math.max(0, scroller.scrollHeight - scroller.clientHeight);
    if (maxScroll <= 0) return false;

    const current = scroller.scrollTop;
    const next = clamp(current + delta, 0, maxScroll);
    if (Math.abs(next - current) < 0.5) return false;

    scroller.scrollTop = next;
    return true;
}

function setupSidebarScrollIsolation() {
    cleanupSidebarScroll();

    const { sidebar, tocScroller } = getSidebarElements();
    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    const cleanup = [];

    if (!sidebar || sidebar.dataset.containedScroll !== "true") return;

    const scrollWithFallback = (delta, scroller, fallbackScroller) => {
        if (scrollElementBy(scroller, delta)) return;
        if (fallbackScroller && scrollElementBy(fallbackScroller, delta)) return;
        window.scrollBy({ top: delta, left: 0, behavior: "auto" });
    };

    const bindWheel = (scroller, fallbackScroller, skipSelector) => {
        const onWheel = (event) => {
            if (!desktopQuery.matches || Math.abs(event.deltaY) < 0.5) return;
            if (skipSelector && event.target?.closest?.(skipSelector)) return;

            event.preventDefault();
            event.stopPropagation();
            scrollWithFallback(normalizeWheelDeltaY(event, scroller), scroller, fallbackScroller);
        };

        scroller.addEventListener("wheel", onWheel, { passive: false });
        cleanup.push(() => scroller.removeEventListener("wheel", onWheel));
    };

    const bindTouch = (scroller, fallbackScroller, skipSelector) => {
        let lastTouchY = 0;

        const onTouchStart = (event) => {
            if (!desktopQuery.matches || event.touches.length !== 1) return;
            if (skipSelector && event.target?.closest?.(skipSelector)) return;
            lastTouchY = event.touches[0].clientY;
        };

        const onTouchMove = (event) => {
            if (!desktopQuery.matches || event.touches.length !== 1) return;
            if (skipSelector && event.target?.closest?.(skipSelector)) return;

            const nextY = event.touches[0].clientY;
            const deltaY = lastTouchY - nextY;
            lastTouchY = nextY;

            if (Math.abs(deltaY) < 0.5) return;

            event.preventDefault();
            event.stopPropagation();
            scrollWithFallback(deltaY, scroller, fallbackScroller);
        };

        scroller.addEventListener("touchstart", onTouchStart, { passive: true });
        scroller.addEventListener("touchmove", onTouchMove, { passive: false });
        cleanup.push(() => {
            scroller.removeEventListener("touchstart", onTouchStart);
            scroller.removeEventListener("touchmove", onTouchMove);
        });
    };

    const nestedScrollSelector = "#toc-sidebar-scroll, [data-music-playlist-scroll]";
    bindWheel(sidebar, null, nestedScrollSelector);
    bindTouch(sidebar, null, nestedScrollSelector);

    if (tocScroller) {
        bindWheel(tocScroller, sidebar);
        bindTouch(tocScroller, sidebar);
    }

    sidebarController.cleanupScroll = () => {
        for (const cleanupItem of cleanup) cleanupItem();
    };
}

function getSidebarSyncAnchor() {
    return (
        document.getElementById("post-container") ||
        document.getElementById("swup-container") ||
        document.getElementById("main-grid")
    );
}

function setupSidebarScrollSync() {
    cleanupSidebarSync();

    const { sidebar } = getSidebarElements();
    const desktopQuery = window.matchMedia("(min-width: 1024px)");
    if (!sidebar || sidebar.dataset.containedScroll !== "true") return;

    let animationFrame = 0;

    const syncSidebarToPage = () => {
        animationFrame = 0;

        if (!desktopQuery.matches) {
            sidebar.scrollTop = 0;
            return;
        }

        const maxScroll = Math.max(0, sidebar.scrollHeight - sidebar.clientHeight);
        if (maxScroll <= 0) {
            sidebar.scrollTop = 0;
            return;
        }

        const anchor = getSidebarSyncAnchor();
        const anchorTop = anchor ? getElementPageTop(anchor) : 0;
        const syncStart = Math.max(0, anchorTop - 180);
        const target = clamp(getPageScrollY() - syncStart, 0, maxScroll);
        sidebar.scrollTop = Math.round(target);
    };

    const scheduleSync = () => {
        if (animationFrame) return;
        animationFrame = requestAnimationFrame(syncSidebarToPage);
    };

    window.addEventListener("scroll", scheduleSync, { passive: true });
    window.addEventListener("resize", scheduleSync);
    window.addEventListener("load", scheduleSync);
    desktopQuery.addEventListener?.("change", scheduleSync);
    scheduleSync();

    sidebarController.cleanupSync = () => {
        if (animationFrame) cancelAnimationFrame(animationFrame);
        window.removeEventListener("scroll", scheduleSync);
        window.removeEventListener("resize", scheduleSync);
        window.removeEventListener("load", scheduleSync);
        desktopQuery.removeEventListener?.("change", scheduleSync);
    };
}

function hideSidebarDuringNavigation() {
    if (sidebarController.revealTimer) {
        window.clearTimeout(sidebarController.revealTimer);
        sidebarController.revealTimer = 0;
    }

    const { sidebarRoot } = getSidebarElements();
    if (!sidebarRoot) return;

    sidebarRoot.classList.add("sidebar-navigation-lock");
    sidebarRoot.style.setProperty("opacity", "0", "important");
    sidebarRoot.style.setProperty("visibility", "hidden", "important");
    sidebarRoot.style.pointerEvents = "none";
}

function revealSidebarAfterNavigation(delay = 48) {
    if (sidebarController.revealTimer) {
        window.clearTimeout(sidebarController.revealTimer);
    }

    sidebarController.revealTimer = window.setTimeout(() => {
        const { sidebarRoot } = getSidebarElements();
        if (sidebarRoot) {
            sidebarRoot.classList.remove("sidebar-navigation-lock");
            sidebarRoot.style.removeProperty("opacity");
            sidebarRoot.style.removeProperty("visibility");
            sidebarRoot.style.pointerEvents = "";
        }
        sidebarController.revealTimer = 0;
    }, delay);
}

function refreshSidebarForCurrentPage(options = {}) {
    const { reset = false, reveal = false } = options;
    clearSidebarRefreshSchedule();
    cleanupSidebarScroll();
    cleanupSidebarSync();

    const { toc } = getSidebarElements();
    const headings = collectArticleHeadings();
    const enabled = buildSidebarToc(toc, headings);

    setSidebarReadingMode(enabled);

    if (!enabled) {
        if (reveal) revealSidebarAfterNavigation();
        return;
    }

    if (reset) resetSidebarScrollPosition();
    setupSidebarScrollIsolation();
    setupSidebarScrollSync();
    if (reveal) revealSidebarAfterNavigation();
}

function scheduleSidebarRefresh(options = {}) {
    clearSidebarRefreshSchedule();

    const run = () => refreshSidebarForCurrentPage(options);
    sidebarController.refreshFrame = requestAnimationFrame(() => {
        sidebarController.refreshFrame = 0;
        run();
    });

    sidebarController.refreshTimers = [
        window.setTimeout(run, 80),
        window.setTimeout(run, 240),
    ];
}

function setupSidebarSwupHooks() {
    if (sidebarController.swupBound) return;
    sidebarController.swupBound = true;

    window.swup?.hooks?.on("visit:start", () => {
        hideSidebarDuringNavigation();
        cleanupSidebarScroll();
        cleanupSidebarSync();
    });
    window.swup?.hooks?.on("content:replace", () => {
        scheduleSidebarRefresh({ reset: true });
    });
    window.swup?.hooks?.on("page:view", () => {
        scheduleSidebarRefresh({ reset: true, reveal: true });
    });
}

if (document.readyState === "loading") {
    document.addEventListener(
        "DOMContentLoaded",
        () => scheduleSidebarRefresh({ reset: false }),
        { once: true },
    );
} else {
    scheduleSidebarRefresh({ reset: false });
}

if (window.swup?.hooks) {
    setupSidebarSwupHooks();
} else {
    document.addEventListener("swup:enable", setupSidebarSwupHooks, { once: true });
}
</script>
