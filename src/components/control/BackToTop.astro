---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex flex-col gap-3">
        <button id="goto-comments-btn" aria-label="Go to Comments" class="btn-card h-[3.75rem] w-[3.75rem]" onclick="scrollToComments()">
            <Icon name="material-symbols:chat-rounded" class="mx-auto"></Icon>
        </button>
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem]" onclick="backToTop()">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 7.5rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    bottom: 17rem
    opacity: 1
    cursor: pointer
    transform: translateX(5rem)
    pointer-events: auto

    &.hide
        transform: translateX(5rem) scale(0.9)
        opacity: 0
        pointer-events: none

    .btn-card
        @apply rounded-2xl
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
function scrollToComments() {
    var el = document.querySelector('#comments-anchor');
    if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.scrollBy(0, -20);
        return;
    }
    // 兜底：如果锚点不存在（页面结构变化），直接尝试滚动到评论区区域
    var fallback = document.querySelector('#twikoo-comments, #comments-section');
    if (fallback) {
        fallback.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.scrollBy(0, -20);
    }
}

var BANNER_HEIGHT = 35;  // 与 constants.ts 保持一致
var btn = document.getElementById('back-to-top-btn');

function isPostPage() {
    return window.location.pathname.startsWith('/posts/');
}

function updateBackToTopVisibility() {
    if (!btn) return;
    // 仅在文章页根据滚动距离控制显示；非文章页永远隐藏
    if (!isPostPage()) {
        btn.classList.add('hide');
        return;
    }
    var scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
    var bannerHeightPx = window.innerHeight * (BANNER_HEIGHT / 100);
    if (scrollTop > bannerHeightPx) {
        btn.classList.remove('hide');
    } else {
        btn.classList.add('hide');
    }
}

// 滚动事件（被动模式，不与 Layout.astro 的 onscroll 冲突）
window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
// 窗口大小变化后重算 banner 高度阈值
window.addEventListener('resize', updateBackToTopVisibility, { passive: true });
// 初始加载时执行
if (document.readyState !== 'loading') {
    updateBackToTopVisibility();
} else {
    document.addEventListener('DOMContentLoaded', updateBackToTopVisibility);
}
// swup 页面切换后重新判断
document.addEventListener('swup:contentReplaced', updateBackToTopVisibility);
</script>
