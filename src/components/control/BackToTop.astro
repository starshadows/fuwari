---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex flex-col gap-3">
        <button id="goto-comments-btn" aria-label="Go to Comments" class="btn-card h-[3.75rem] w-[3.75rem]" onclick="scrollToComments()">
            <Icon name="material-symbols:chat-rounded" class="mx-auto"></Icon>
        </button>
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem]" onclick="backToTop()">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 7.5rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    bottom: 17rem
    opacity: 1
    cursor: pointer
    transform: translateX(5rem)
    pointer-events: auto

    &.hide
        transform: translateX(5rem) scale(0.9)
        opacity: 0
        pointer-events: none

    .btn-card
        @apply rounded-2xl
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
function scrollToComments() {
    const el = document.querySelector('#twikoo-comments');
    if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.scrollBy(0, -20)
    }
}
</script>
